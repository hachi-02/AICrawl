# ==========================================================
#  AI & Crypto News Crawler - cau hinh mau
#  Copy file nay thanh .env roi dien gia tri that
# ==========================================================

# ---------- Duong dan ----------
DATABASE_PATH=data/news.db
LOG_FILE=logs/crawler.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
TIMEZONE=Asia/Ho_Chi_Minh

# ---------- Browser ----------
# chromium | camoufox
BROWSER_ENGINE=chromium
BROWSER_HEADLESS=true
BROWSER_LOCALE=en-US
# Bo trong de tu dong lay UA mac dinh cua browser
BROWSER_USER_AGENT=
BROWSER_VIEWPORT_WIDTH=1440
BROWSER_VIEWPORT_HEIGHT=900
BROWSER_TIMEOUT_MS=30000
# Ghi trace Playwright de debug: logs/traces/*.zip (xem bang `playwright show-trace`)
TRACE_ENABLED=false
# Chan tai image/font/media de crawl nhanh hon
BLOCK_MEDIA=true

# ---------- Camoufox (chi dung de nghien cuu browser fingerprint) ----------
CAMOUFOX_HEADLESS=true
# windows | macos | linux | "windows,linux"
CAMOUFOX_OS=
CAMOUFOX_HUMANIZE=0.0
CAMOUFOX_BLOCK_IMAGES=true
CAMOUFOX_BLOCK_WEBRTC=true
CAMOUFOX_I18N=en-US
CAMOUFOX_EXECUTABLE_PATH=

# ---------- Crawler ----------
MAX_CONCURRENT_SOURCES=4
MAX_ARTICLES_PER_SOURCE=12
REQUEST_DELAY_SECONDS=1.5
SOURCE_TIMEOUT_SECONDS=90
RETRY_ATTEMPTS=2
RETRY_BACKOFF_SECONDS=3.0
RESPECT_ROBOTS_TXT=true
SCROLL_ROUNDS=3
# Chi crawl nhung nguon nay (bo trong = tat ca)
ENABLED_SOURCES=
# Tat nguon bi chan bot (Cloudflare 403). Ta khong dung ky thuat ne chan.
DISABLED_SOURCES=theblock,beincrypto

# ---------- Dedup ----------
# Cung nguon: tieu de sua nhe -> Jaccard(token) >= nguong
DEDUPE_JACCARD_THRESHOLD=0.70
# Khac nguon, cung mot su kien -> overlap(token tieu de) >= nguong.
# 0.80 = rat than trong (chi gop khi tieu de giong nhau rat nhieu).
# 0.0  = tat lop nay, chi ghep trung chinh xac (URL + content_hash).
DEDUPE_CROSS_SOURCE_OVERLAP=0.80
# Chi gom tin khuac nguon neu thoi gian dang cach nhau <= so gio nay
DEDUPE_CROSS_SOURCE_WINDOW_HOURS=36
# So ngay du lieu nap vao index de so khop
DEDUPE_WINDOW_DAYS=7

# ---------- Trend ----------
TREND_MIN_SCORE=0.5
TREND_MAX_AGE_HOURS=24
TREND_MAX_PER_CATEGORY=5
TREND_FRESHNESS_HALF_LIFE_HOURS=6.0
TREND_TOPIC_WINDOW_MINUTES=60

# ---------- Telegram ----------
# Bat Telegram neu de trong token (chi crawl, khong gui)
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Danh sach user id duoc phep dung lenh, cach nhau dau phay. De trong = dung TELEGRAM_CHAT_ID
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_RATE_LIMIT_SECONDS=1.5
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BASE_DELAY=2.0

# ---------- Scheduler ----------
AUTO_CRAWL_ENABLED=true
# 1440 phut = 1 ngay. Bot khong crawl ngay khi startup.
CRAWL_INTERVAL_MINUTES=1440
